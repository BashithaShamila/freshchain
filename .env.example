# Copy to .env and fill in from the Asgardeo console.
# Full walkthrough: docs/asgardeo-setup.md
#
# This file is committed as a template. NEVER put real secrets in it — real
# values belong in .env, which is gitignored.

# Your Asgardeo organisation handle, from the console URL:
#   https://console.asgardeo.io/t/<ASGARDEO_ORG>
ASGARDEO_ORG=CHANGE_ME

# From your Standard-Based (OIDC) application's Protocol tab. The secret is
# used only by scripts/asgardeo-login.py to exchange and refresh tokens.
ASGARDEO_CLIENT_ID=CHANGE_ME
ASGARDEO_CLIENT_SECRET=CHANGE_ME

# The React frontend is a SECOND Asgardeo application, of type Single-Page
# Application: a browser cannot hold a client secret, so the SPA is a public
# client using PKCE. See docs/asgardeo-setup.md.
ASGARDEO_SPA_CLIENT_ID=CHANGE_ME
FRONTEND_PORT=3001
# Must match a redirect URL registered on the SPA application. In production
# this is your public https:// address.
FRONTEND_URL=http://localhost:3001

# Which access-token claims carry roles. Run `make check-idp` to see what your
# tenant actually emits; adjust if your roles land somewhere else.
FRESHCHAIN_ROLE_CLAIMS=roles,groups

# Demo users you created in Asgardeo. `make login` runs an authorization code
# + PKCE flow in your browser for each of them; these names are used to label
# the cached tokens under .tokens/, and the passwords are only ever typed by
# you into Asgardeo's own sign-in page.
FRESHCHAIN_CUSTOMER_USER=alice
FRESHCHAIN_CUSTOMER_PASSWORD=
FRESHCHAIN_SECOND_CUSTOMER_USER=bob
FRESHCHAIN_SECOND_CUSTOMER_PASSWORD=
FRESHCHAIN_OPERATOR_USER=wanda
FRESHCHAIN_OPERATOR_PASSWORD=
FRESHCHAIN_ADMIN_USER=freshchain-admin
FRESHCHAIN_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Production knobs. Defaults suit local development; set these on a real
# deployment.
# ---------------------------------------------------------------------------
# Postgres superuser password (also used by the services' datasource).
# POSTGRES_PASSWORD=freshchain
# Grafana admin password.
# GRAFANA_ADMIN_PASSWORD=admin
# Swagger UI / OpenAPI docs on the three services. They are reachable without
# authentication (directly and via the gateway's /docs/* routes), so switch
# them off on anything public-facing.
# FRESHCHAIN_API_DOCS_ENABLED=false
# Where service images come from. Unset, compose builds locally and tags
# freshchain/<service>:local. On a server, point these at the registry your
# CI pushes to and `docker compose pull` instead of building on the box.
# FRESHCHAIN_IMAGE_PREFIX=ghcr.io/<github-user>/freshchain
# FRESHCHAIN_IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# Published host ports. Only change these if something else on your machine
# already owns one — the services talk to each other over the compose network
# and are unaffected. Note that KAFKA_PORT is also advertised to host clients,
# so it has to match what is published.
# ---------------------------------------------------------------------------
# POSTGRES_PORT=5432
# KAFKA_PORT=29092
# REDIS_PORT=6379
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# GATEWAY_PORT=8080
# ORDER_PORT=8081
# INVENTORY_PORT=8082
# FULFILLMENT_PORT=8083
